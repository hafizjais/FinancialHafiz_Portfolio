# Canonical site origin used for canonical URL, Open Graph URLs, robots.txt and sitemap.xml.
# Set this to your production domain (no trailing slash). On Vercel it falls back to
# the project's production domain when unset.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Optional: link to a full privacy policy hosted elsewhere. Defaults to the built-in /privasi page.
NEXT_PUBLIC_PRIVACY_POLICY_URL=

# Hero A/B test: "true" splits visitors 50/50 between headline A and B (sticky for 30 days).
# ?hv=a or ?hv=b in the URL always forces a variant, even when this is off.
AB_TEST_ENABLED=false

# Analytics (all optional — nothing loads unless an ID is set).
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GTM_ID=
# Log analytics events to the browser console in production builds.
NEXT_PUBLIC_ANALYTICS_DEBUG=false
